{
  "name": "image-video-compressor",
  "version": "1.0.0",
  "description": "Secure, isomorphic image & video optimizer for Node.js and the browser. Compress photos to WebP/AVIF and videos with H.264/VP9 CRF (typically 70-90% smaller, original dimensions kept) using sharp, fluent-ffmpeg and ffmpeg.wasm. Includes Express & Next.js middleware, SSRF/path-traversal/pixel-bomb protection and EXIF stripping. Created by Yeasaleh. Inspired by Nurix hive Team.",
  "author": "Yeasaleh",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./express": {
      "types": "./dist/middleware/express.d.ts",
      "default": "./dist/middleware/express.js"
    },
    "./next": {
      "types": "./dist/middleware/next.d.ts",
      "default": "./dist/middleware/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
